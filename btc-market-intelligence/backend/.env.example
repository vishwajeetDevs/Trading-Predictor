# Copy to backend/.env or root .env. No Delta trading key is used or accepted.
DATABASE_URL=postgresql+psycopg://btc:btc@127.0.0.1:5432/btc_intelligence
DELTA_REST_BASE=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
USER_AGENT=btc-market-intelligence/0.1
REQUEST_MIN_INTERVAL_SECONDS=0.25
HTTP_TIMEOUT_SECONDS=20
MAX_RETRIES=4
LOOKBACK_DAYS=180
ENABLE_WEBSOCKET=true
CANDLE_CHUNK_SIZE=1500
MAX_CANDLE_PAGE=2000
STALE_AFTER_SECONDS=180
WS_HEARTBEAT_TIMEOUT_SECONDS=35
ENABLE_STUDIES=true
STUDY_INTERVAL_SECONDS=900
ENABLE_DERIVATIVES=true
DERIVATIVES_POLL_SECONDS=60
ORDERBOOK_DEPTH=15
ORDERBOOK_RETENTION_HOURS=48
DERIVATIVES_RETENTION_DAYS=90
MARK_RETENTION_DAYS=14
FUNDING_NEAR_ZERO=0.0001
FUNDING_MIN_SAMPLE=30
FUNDING_LOOKBACK_DAYS=30
MARK_DIVERGENCE_PERCENT=0.001
BOOK_IMBALANCE_THRESHOLD=0.2
LOG_LEVEL=INFO

