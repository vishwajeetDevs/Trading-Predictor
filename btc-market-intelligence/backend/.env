# BTC Market Intelligence Environment Configuration
# No Delta trading key is used or accepted (public read-only endpoints only).

# Database (PostgreSQL via psycopg v3)
DATABASE_URL=postgresql+psycopg://neondb_owner:npg_YmUa31dQScoK@ep-holy-butterfly-bdaii84y-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Delta Exchange India Public Endpoints
DELTA_REST_BASE=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
USER_AGENT=btc-market-intelligence/0.1

# HTTP & Rate Limiting
REQUEST_MIN_INTERVAL_SECONDS=0.25
HTTP_TIMEOUT_SECONDS=20
MAX_RETRIES=4

# Ingestion & Backfill
LOOKBACK_DAYS=180
ENABLE_WEBSOCKET=true
CANDLE_CHUNK_SIZE=1500
MAX_CANDLE_PAGE=2000
STALE_AFTER_SECONDS=180
WS_HEARTBEAT_TIMEOUT_SECONDS=35

# Historical Studies (Phase 2 & 3)
ENABLE_STUDIES=true
STUDY_INTERVAL_SECONDS=900

# Derivatives Collection & Thresholds (Phase 4)
ENABLE_DERIVATIVES=true
DERIVATIVES_POLL_SECONDS=60
ORDERBOOK_DEPTH=15
ORDERBOOK_RETENTION_HOURS=48
DERIVATIVES_RETENTION_DAYS=90
MARK_RETENTION_DAYS=14
FUNDING_NEAR_ZERO=0.0001
FUNDING_MIN_SAMPLE=30
FUNDING_LOOKBACK_DAYS=30
MARK_DIVERGENCE_PERCENT=0.001
BOOK_IMBALANCE_THRESHOLD=0.2

# Logging
LOG_LEVEL=INFO
